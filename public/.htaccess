# BUXDEV static export: canonical URLs, error handling and delivery policy.

Options -Indexes

<Files "contact.php">
  LimitRequestBody 16384
</Files>

<FilesMatch "(?i)(^\.(?!well-known$)|\.(?:bak|old|orig|save|log|sql|map|ini|ya?ml|md|lock|sh)$|^(?:package(?:-lock)?\.json|composer\.(?:json|lock)|tsconfig\.json|.*config\.php|contact-security\.php)$)">
  Require all denied
</FilesMatch>

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let cPanel/AutoSSL serve certificate challenges without canonical redirects.
  RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [L]

  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule ^(?:server|scripts|node_modules|tests|coverage|private)(?:/|$) - [F,L,NC]
  RewriteCond %{REQUEST_URI} !^/api/contact\.php$
  RewriteRule \.php(?:/|$) - [F,L,NC]

  # Do not redirect plaintext API bodies to HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^api/contact\.php$ - [F,L]

  # The contact API is a real PHP endpoint.
  # Never redirect or rewrite its requests.
  RewriteRule ^api/contact\.php$ - [L]

  # Collapse the root Next export entry point into the canonical homepage.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ https://buxdev.com/ [R=301,L,NE]

  # Collapse explicit Next export entry points into their clean canonical URLs.
  RewriteCond %{THE_REQUEST} \s+/(?:about|services|work|contact|privacidad|terminos)/index\.html(?:[?\s]) [NC]
  RewriteRule ^(about|services|work|contact|privacidad|terminos)/index\.html$ https://buxdev.com/$1/ [R=301,L,NE]

  # Keep exported page routes on the trailing-slash convention.
  RewriteCond %{THE_REQUEST} \s+/(?:about|services|work|contact|privacidad|terminos)(?:[?\s]) [NC]
  RewriteRule ^(about|services|work|contact|privacidad|terminos)$ https://buxdev.com/$1/ [R=301,L,NE]

  # Resolve HTTP and WWW variants directly to the only canonical origin.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^buxdev\.com$ [NC]
  RewriteRule ^ https://buxdev.com%{REQUEST_URI} [R=301,L,NE]

  # Direct access to Next's error artifacts must remain a real 404.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+404\.html(?:[?\s]) [NC]
  RewriteRule ^404\.html$ - [R=404,L]

  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(?:404|_not-found)(?:/.*)?$ - [R=404,L]
</IfModule>

<IfModule mod_setenvif.c>
  # Mark fingerprinted Next.js assets for long-term immutable caching.
  SetEnvIf Request_URI "^/_next/static/" BUXDEV_IMMUTABLE=1

  # Mark the contact API so it is never cached.
  SetEnvIf Request_URI "^/api/contact\.php$" BUXDEV_CONTACT_API=1
</IfModule>

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "0"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  # postbuild replaces this block with the exact export hashes (fail closed).
  # BUXDEV_CSP_START
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';"
  # BUXDEV_CSP_END

  # Next.js fingerprints files below /_next/static/.
  # These assets are safe to cache for one year.
  Header always set Cache-Control "public, max-age=31536000, immutable" env=BUXDEV_IMMUTABLE

  # These brand filenames are stable, not content-hashed. Cache for one day,
  # then revalidate with Last-Modified/ETag; never mark them immutable.
  SetEnvIf Request_URI "^/brand/buxdev/(logo|mark)-on-(dark|light)\.svg$" BUXDEV_BRAND_ASSET=1
  Header always set Cache-Control "public, max-age=86400, must-revalidate" env=BUXDEV_BRAND_ASSET

  # HTML documents must revalidate after deployments.
  <FilesMatch "\.(?:html?)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # Search-engine directives must also revalidate.
  <FilesMatch "^(?:robots\.txt|sitemap\.xml)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # Defense in depth:
  # contact.php also emits no-store from PHP itself.
  Header always set Cache-Control "no-store, max-age=0" env=BUXDEV_CONTACT_API
</IfModule>

<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
      text/html \
      text/css \
      text/plain \
      text/javascript \
      text/xml \
      application/javascript \
      application/json \
      application/xml \
      image/svg+xml
  </IfModule>
</IfModule>
